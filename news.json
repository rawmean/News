"{    \"translations\": [        {            \"english_version\": \"A 14-year-old boy killed his grandparents and then shot five teachers at his school.\",            \"english_title\": \"Boy Attacks Family and School\",            \"translated_version\": \"Un ni\u00f1o de 14 a\u00f1os mat\u00f3 a sus abuelos y luego dispar\u00f3 a cinco maestros en su escuela.\",            \"translated_title\": \"Ni\u00f1o Ataca a Familia y Escuela\"        },        {            \"english_version\": \"Italy has refused to accept demands after many migrants crossed from Morocco to Ceuta last week.\",            \"english_title\": \"Italy Rejects Migrant Demands\",            \"translated_version\": \"Italia ha rechazado aceptar demandas despu\u00e9s de que muchos migrantes cruzaron de Marruecos a Ceuta la semana pasada.\",            \"translated_title\": \"Italia Rechaza Demandas de Migrantes\"        },        {            \"english_version\": \"At least 34,002 properties in Ukraine have been taken or are set to be taken since 2024, according to a BBC investigation.\",            \"english_title\": \"Properties Taken in Ukraine\",            \"translated_version\": \"Al menos 34,002 propiedades en Ucrania han sido tomadas o ser\u00e1n tomadas desde 2024, seg\u00fan una investigaci\u00f3n de la BBC.\",            \"translated_title\": \"Propiedades Tomadas en Ucrania\"        },        {            \"english_version\": \"A group moved synthetic drugs from Spain to Algeria and used the return trip to smuggle migrants and weapons.\",            \"english_title\": \"Drug and Migrant Smuggling\",            \"translated_version\": \"Un grupo movi\u00f3 drogas sint\u00e9ticas de Espa\u00f1a a Argelia y us\u00f3 el viaje de regreso para pasar migrantes y armas.\",            \"translated_title\": \"Tr\u00e1fico de Drogas y Migrantes\"        },        {            \"english_version\": \"Weeks after protests in Delhi, a new youth-led movement about jobs and recruitment is growing in Jharkhand.\",            \"english_title\": \"Youth Movement in Jharkhand\",            \"translated_version\": \"Semanas despu\u00e9s de protestas en Delhi, un nuevo movimiento liderado por j\u00f3venes sobre trabajos y reclutamiento est\u00e1 creciendo en Jharkhand.\",            \"translated_title\": \"Movimiento Juvenil en Jharkhand\"        }    ]}"