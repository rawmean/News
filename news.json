"{    \"translations\": [        {            \"english_version\": \"Fifa is upset about efforts to harm its reputation and its president, Gianni Infantino.\",            \"english_title\": \"Fifa Upset\",            \"translated_version\": \"Fifa est\u00e1 enojada porque hay personas que quieren da\u00f1ar su reputaci\u00f3n y a su presidente, Gianni Infantino.\",            \"translated_title\": \"Fifa Enojada\"        },        {            \"english_version\": \"Israel plans to take over large areas of land in historic Palestinian regions of the West Bank.\",            \"english_title\": \"Israel Plans\",            \"translated_version\": \"Israel planea tomar grandes \u00e1reas de tierra en regiones hist\u00f3ricas palestinas de Cisjordania.\",            \"translated_title\": \"Planes de Israel\"        },        {            \"english_version\": \"The Irish Prison Service bought a special van to safely transport a 49-year-old man to court after he was brought back from Dubai.\",            \"english_title\": \"Special Van for Transport\",            \"translated_version\": \"El Servicio de Prisiones de Irlanda compr\u00f3 una furgoneta especial para llevar a un hombre de 49 a\u00f1os al tribunal despu\u00e9s de que lo trajeron de vuelta de Dub\u00e1i.\",            \"translated_title\": \"Furgoneta Especial\"        },        {            \"english_version\": \"A wildfire in British Columbia, Canada, is still not under control and has spread over a large area.\",            \"english_title\": \"Wildfire in Canada\",            \"translated_version\": \"Un incendio en Columbia Brit\u00e1nica, Canad\u00e1, todav\u00eda no est\u00e1 controlado y se ha extendido por una gran \u00e1rea.\",            \"translated_title\": \"Incendio en Canad\u00e1\"        },        {            \"english_version\": \"Russia continued its attacks after Ukraine's president warned that they are running low on missile interceptors.\",            \"english_title\": \"Russia Continues Attacks\",            \"translated_version\": \"Rusia continu\u00f3 sus ataques despu\u00e9s de que el presidente de Ucrania advirti\u00f3 que se est\u00e1n quedando sin interceptores de misiles.\",            \"translated_title\": \"Rusia Sigue Atacando\"        }    ]}"