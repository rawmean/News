"{    \"translations\": [        {            \"english_version\": \"Martial law has been in place in Ukraine since February 2022, which means elections are on hold.\",            \"english_title\": \"Martial Law in Ukraine\",            \"translated_version\": \"La ley marcial est\u00e1 en Ucrania desde febrero de 2022, lo que significa que no hay elecciones.\",            \"translated_title\": \"Ley Marcial en Ucrania\"        },        {            \"english_version\": \"Environmentalists have criticized the drilling in the sea near the Amazon River.\",            \"english_title\": \"Drilling Near Amazon Criticized\",            \"translated_version\": \"Los ambientalistas han criticado la perforaci\u00f3n en el mar cerca del r\u00edo Amazonas.\",            \"translated_title\": \"Perforaci\u00f3n Cerca del Amazonas Criticada\"        },        {            \"english_version\": \"Meta said that social media addiction is not real during a trial from a big lawsuit by US states.\",            \"english_title\": \"Meta on Social Media Addiction\",            \"translated_version\": \"Meta dijo que la adicci\u00f3n a las redes sociales no es real durante un juicio de una gran demanda de estados de EE.UU.\",            \"translated_title\": \"Meta sobre Adicci\u00f3n a Redes Sociales\"        },        {            \"english_version\": \"Erin Patterson was found guilty last year of killing three family members by giving them beef Wellington with poisonous mushrooms.\",            \"english_title\": \"Erin Patterson Guilty\",            \"translated_version\": \"Erin Patterson fue encontrada culpable el a\u00f1o pasado de matar a tres familiares d\u00e1ndoles carne Wellington con hongos venenosos.\",            \"translated_title\": \"Erin Patterson Culpable\"        },        {            \"english_version\": \"A number of buildings and cars are damaged in the historic city, and the famous Alhambra palace has temporarily closed.\",            \"english_title\": \"Damage in Historic City\",            \"translated_version\": \"Varios edificios y coches est\u00e1n da\u00f1ados en la ciudad hist\u00f3rica, y el famoso palacio de la Alhambra ha cerrado temporalmente.\",            \"translated_title\": \"Da\u00f1os en Ciudad Hist\u00f3rica\"        }    ]}"