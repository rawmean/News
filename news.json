"{    \"translations\": [        {            \"english_version\": \"A big wildfire is burning about nine miles from Bordeaux, but officials say the city is not in danger yet.\",            \"english_title\": \"Wildfire Near Bordeaux\",            \"translated_version\": \"Un gran incendio est\u00e1 quemando a unas nueve millas de Burdeos, pero los oficiales dicen que la ciudad no est\u00e1 en peligro todav\u00eda.\",            \"translated_title\": \"Incendio Cerca de Burdeos\"        },        {            \"english_version\": \"There are reports of an explosion at the Aeon Mall in Kumamoto after a 7.1 magnitude earthquake.\",            \"english_title\": \"Explosion in Kumamoto\",            \"translated_version\": \"Hay reportes de una explosi\u00f3n en el Aeon Mall en Kumamoto despu\u00e9s de un terremoto de magnitud 7.1.\",            \"translated_title\": \"Explosi\u00f3n en Kumamoto\"        },        {            \"english_version\": \"Zinedine Zidane, who used to manage Real Madrid, is now the head coach of the France national soccer team.\",            \"english_title\": \"Zidane Coaches France\",            \"translated_version\": \"Zinedine Zidane, quien antes dirig\u00eda al Real Madrid, ahora es el entrenador del equipo nacional de f\u00fatbol de Francia.\",            \"translated_title\": \"Zidane Entrena a Francia\"        },        {            \"english_version\": \"Ukraine's leader wants to strengthen US support for Kyiv's missile defenses because Russia is increasing its attacks.\",            \"english_title\": \"Ukraine Seeks US Support\",            \"translated_version\": \"El l\u00edder de Ucrania quiere fortalecer el apoyo de EE.UU. para las defensas de misiles de Kyiv porque Rusia est\u00e1 aumentando sus ataques.\",            \"translated_title\": \"Ucrania Busca Apoyo de EE.UU.\"        },        {            \"english_version\": \"Ecuador's police are dealing with a big increase in drug crime, and the BBC is reporting on their efforts.\",            \"english_title\": \"Ecuador's Drug Crime Rise\",            \"translated_version\": \"La polic\u00eda de Ecuador est\u00e1 lidiando con un gran aumento en el crimen de drogas, y la BBC est\u00e1 reportando sobre sus esfuerzos.\",            \"translated_title\": \"Aumento del Crimen de Drogas en Ecuador\"        }    ]}"