"{    \"translations\": [        {            \"english_version\": \"The US has used up many weapons that are hard to make, according to public information.\",            \"english_title\": \"US Weapons Shortage\",            \"translated_version\": \"Estados Unidos ha usado muchas armas que son dif\u00edciles de hacer, seg\u00fan informaci\u00f3n p\u00fablica.\",            \"translated_title\": \"Escasez de Armas en EE.UU.\"        },        {            \"english_version\": \"Fifa supports president Gianni Infantino, but Uefa says this does not change anything.\",            \"english_title\": \"Fifa and Uefa Disagreement\",            \"translated_version\": \"Fifa apoya al presidente Gianni Infantino, pero Uefa dice que esto no cambia nada.\",            \"translated_title\": \"Desacuerdo entre Fifa y Uefa\"        },        {            \"english_version\": \"Ukraine's president says the strikes are meant to reduce the money Russia uses for its war.\",            \"english_title\": \"Ukraine's Strategy\",            \"translated_version\": \"El presidente de Ucrania dice que los ataques son para reducir el dinero que Rusia usa para su guerra.\",            \"translated_title\": \"Estrategia de Ucrania\"        },        {            \"english_version\": \"Amal Khalil was killed and Zeinab Faraj was injured in an Israeli attack in April; Israel says they did not target the journalists.\",            \"english_title\": \"Journalists in Danger\",            \"translated_version\": \"Amal Khalil muri\u00f3 y Zeinab Faraj fue herida en un ataque israel\u00ed en abril; Israel dice que no apuntaron a los periodistas.\",            \"translated_title\": \"Periodistas en Peligro\"        },        {            \"english_version\": \"Seoul's lunar orbiter took pictures of the Moon before and after a part of SpaceX's rocket hit it on Wednesday.\",            \"english_title\": \"Moon Pictures\",            \"translated_version\": \"El orbitador lunar de Se\u00fal tom\u00f3 fotos de la Luna antes y despu\u00e9s de que una parte del cohete de SpaceX la golpeara el mi\u00e9rcoles.\",            \"translated_title\": \"Fotos de la Luna\"        }    ]}"