"{    \"translations\": [        {            \"english_version\": \"Ukraine said the video showing a scared civilian being chased by a drone was a war crime.\",            \"english_title\": \"Drone War Crime\",            \"translated_version\": \"Ucrania dijo que el video mostrando a un civil asustado siendo perseguido por un dron era un crimen de guerra.\",            \"translated_title\": \"Crimen de Guerra con Dron\"        },        {            \"english_version\": \"US Secretary of State Marco Rubio and Treasury Secretary Scott Bessent said talks have progressed to allow shipments to start again.\",            \"english_title\": \"US Talks on Shipments\",            \"translated_version\": \"El Secretario de Estado de EE.UU. Marco Rubio y el Secretario del Tesoro Scott Bessent dijeron que las conversaciones han avanzado para permitir que los env\u00edos comiencen de nuevo.\",            \"translated_title\": \"Conversaciones de EE.UU. sobre Env\u00edos\"        },        {            \"english_version\": \"Bodies of two extended families were recently found under rubble in Gaza City.\",            \"english_title\": \"Families Found in Gaza\",            \"translated_version\": \"Cuerpos de dos familias grandes fueron encontrados recientemente bajo escombros en la Ciudad de Gaza.\",            \"translated_title\": \"Familias Encontradas en Gaza\"        },        {            \"english_version\": \"About 70,000 of the 72,000 people who came to Ceuta illegally last week have been sent back to Morocco, according to Spain.\",            \"english_title\": \"Ceuta Migrants Sent Back\",            \"translated_version\": \"Unos 70,000 de las 72,000 personas que llegaron a Ceuta ilegalmente la semana pasada han sido enviadas de vuelta a Marruecos, seg\u00fan Espa\u00f1a.\",            \"translated_title\": \"Migrantes de Ceuta Devueltos\"        },        {            \"english_version\": \"There are three wildfires in the Spokane area that have forced 60,000 people to leave their homes.\",            \"english_title\": \"Wildfires in Spokane\",            \"translated_version\": \"Hay tres incendios forestales en el \u00e1rea de Spokane que han obligado a 60,000 personas a dejar sus casas.\",            \"translated_title\": \"Incendios en Spokane\"        }    ]}"