"{    \"translations\": [        {            \"english_version\": \"US President Trump's son-in-law Jared Kushner is trying to get support from Israel for a peace plan in Gaza that the US supports.\",            \"english_title\": \"Kushner Seeks Israel's Support\",            \"translated_version\": \"El yerno del presidente de EE.UU., Trump, Jared Kushner, est\u00e1 tratando de obtener apoyo de Israel para un plan de paz en Gaza que apoya EE.UU.\",            \"translated_title\": \"Kushner busca apoyo de Israel\"        },        {            \"english_version\": \"The outbreak of Ebola is growing fast and is caused by a rare type called Bundibugyo.\",            \"english_title\": \"Ebola Outbreak Grows\",            \"translated_version\": \"El brote de \u00c9bola est\u00e1 creciendo r\u00e1pido y es causado por un tipo raro llamado Bundibugyo.\",            \"translated_title\": \"Brote de \u00c9bola crece\"        },        {            \"english_version\": \"A 14-year-old child and four others were hurt, according to the acting governor of Russia's Belgorod region.\",            \"english_title\": \"Child Hurt in Belgorod\",            \"translated_version\": \"Un ni\u00f1o de 14 a\u00f1os y otras cuatro personas resultaron heridas, seg\u00fan el gobernador interino de la regi\u00f3n de Belgorod en Rusia.\",            \"translated_title\": \"Ni\u00f1o herido en Belgorod\"        },        {            \"english_version\": \"An earthquake killed 53 people and forced thousands to leave their homes. It happened early on Saturday.\",            \"english_title\": \"Earthquake Causes Deaths\",            \"translated_version\": \"Un terremoto mat\u00f3 a 53 personas y oblig\u00f3 a miles a dejar sus casas. Sucedi\u00f3 temprano el s\u00e1bado.\",            \"translated_title\": \"Terremoto causa muertes\"        },        {            \"english_version\": \"About 200 firefighters are working to stop fires from reaching Salamina, and one fire is now under control.\",            \"english_title\": \"Firefighters Battle Fires\",            \"translated_version\": \"Unos 200 bomberos est\u00e1n trabajando para evitar que los incendios lleguen a Salamina, y un incendio ya est\u00e1 bajo control.\",            \"translated_title\": \"Bomberos luchan contra incendios\"        }    ]}"