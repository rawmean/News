"{    \"translations\": [        {            \"english_version\": \"A search and rescue operation is happening to find people who survived on Flores, an island in eastern Indonesia.\",            \"english_title\": \"Rescue in Flores\",            \"translated_version\": \"Una operaci\u00f3n de b\u00fasqueda y rescate est\u00e1 pasando para encontrar personas que sobrevivieron en Flores, una isla en el este de Indonesia.\",            \"translated_title\": \"Rescate en Flores\"        },        {            \"english_version\": \"Construction workers found a hidden stash in the walls of a cellar while they were drilling to lay sewage pipes.\",            \"english_title\": \"Hidden Stash Found\",            \"translated_version\": \"Trabajadores de construcci\u00f3n encontraron un escondite en las paredes de un s\u00f3tano mientras hac\u00edan agujeros para poner tuber\u00edas de desag\u00fce.\",            \"translated_title\": \"Escondite Encontrado\"        },        {            \"english_version\": \"Thousands of sailors on the Lincoln ship have faced problems like not enough food and broken plumbing. Some sailors are thinking about jumping overboard.\",            \"english_title\": \"Problems on Lincoln Ship\",            \"translated_version\": \"Miles de marineros en el barco Lincoln han tenido problemas como no suficiente comida y tuber\u00edas rotas. Algunos marineros est\u00e1n pensando en saltar al agua.\",            \"translated_title\": \"Problemas en Barco Lincoln\"        },        {            \"english_version\": \"Two families have been stuck in their homes in the occupied West Bank for several days.\",            \"english_title\": \"Families Stuck in West Bank\",            \"translated_version\": \"Dos familias han estado atrapadas en sus casas en la ocupada Cisjordania por varios d\u00edas.\",            \"translated_title\": \"Familias Atrapadas en Cisjordania\"        },        {            \"english_version\": \"A storm cut power to more than 20,000 homes and left 7,000 people stuck at Tokyo's Narita airport.\",            \"english_title\": \"Storm Hits Tokyo\",            \"translated_version\": \"Una tormenta cort\u00f3 la electricidad a m\u00e1s de 20,000 casas y dej\u00f3 a 7,000 personas atrapadas en el aeropuerto Narita de Tokio.\",            \"translated_title\": \"Tormenta en Tokio\"        }    ]}"